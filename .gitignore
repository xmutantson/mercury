tools/crash_loop_test.py
tools/data_integrity_test.py
tools/turbo_gdb_test.py
tools/watchpoint_gdb.py

# Windows short filename artifacts
NDH6SA~M

# Fact documents — investigation/design notes that live alongside code
# for context but should NOT be pushed upstream. Local working memory,
# not the canonical upstream record.
fact-documents/

# Test result JSONs at repo root (benchmark/loopback output, not source)
/v2_*.json

# Cross-built binaries
/mercury_aarch64

# Reference docs (large, not source)
/Mercury_Mode_Reference.pdf

# Python bytecode cache
__pycache__/

# Temp / scratch files
*_tmp.txt

# IONOS test result directories
/ionos_results/

# IONOS test harness — dev-machine-specific (refs internal build server IPs)
/ionos_test.py

# Dev-machine scripts in tools/ are not for upstream by default.
# Whitelist (!) the ones that ARE source — currently tracked as of
# this gitignore commit. New tools must be either added to the
# whitelist OR named differently to be tracked.
tools/*.py
tools/*.sh
